# Copy to .env and fill in. Never commit .env.

# hermes: "mock" runs the built-in fake, "live" calls the real endpoint.
HERMES_MODE=mock
HERMES_ENDPOINT=
HERMES_API_KEY=

# publisher: "mock" writes to the local log, "x" posts to X.
PUBLISHER=mock

# X API v2, OAuth 1.0a user context. Required only when PUBLISHER=x.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=

# Approval UI. Leave both blank to run with no auth (local only).
UI_USERNAME=
UI_PASSWORD=

DB_PATH=data/social.db
CONFIG_PATH=config/content.yaml
